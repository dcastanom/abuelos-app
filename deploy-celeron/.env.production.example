# Production env for the Celeron / 4GB deployment PC (native Windows).
# Copy to .env.production (or .env, whichever app.core.config.py / next.config.ts load)
# on the target machine and fill in real values. Never commit the filled-in file.

# ── Database ───────────────────────────────────────────────────────────────
# SQLite file, embedded — no server/daemon to install or configure.
# MUST be an absolute path OUTSIDE the backend/ folder: the "update the app"
# workflow overwrites backend/'s contents wholesale, which would destroy an
# in-tree database file. Adjust the drive/path to wherever you cloned the repo.
DATABASE_URL=sqlite+aiosqlite:///C:/abuelos-app/data/abuelos.db

# ── Authentication ─────────────────────────────────────────────────────────
# Generate a real secret, e.g.: openssl rand -hex 32
JWT_SECRET=change-me-to-a-real-random-secret

# ── URLs (single-machine access only, so localhost is correct) ────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Email (SMTP) — required for company registration confirmation emails ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourcompany.com
SMTP_PASSWORD=your-smtp-password
